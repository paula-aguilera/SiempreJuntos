<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet: para ver el clima de hoy -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Avisos de remedios, agua y citas médicas -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ubicación: para enviar el lugar cuando la persona pide ayuda y para el clima -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Modo audio: permite usar la voz del teléfono (texto a voz) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_siempre"
        android:label="SiempreJuntos"
        android:roundIcon="@mipmap/ic_siempre"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiempreJuntosApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MasActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".VideoWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".AyudaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".EstoyBienActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".FamiliaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RecuerdosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".EmergenciaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MiDiaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AprenderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".LeccionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BienestarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ConfigContenidoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".FeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PasajeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RecordatoriosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AlarmaDetalleActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AlarmaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".AlarmaReceiver"
            android:exported="false" />
        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
