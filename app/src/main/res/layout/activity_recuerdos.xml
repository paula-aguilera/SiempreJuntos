<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Mis recuerdos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFotos"
                style="@style/AM.Boton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_naranja"
                android:minHeight="80dp"
                android:text="📷 FOTOS"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnAudios"
                style="@style/AM.Boton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_azul"
                android:minHeight="80dp"
                android:text="🎧 AUDIOS"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVacio"
            style="@style/AM.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Aún no hay recuerdos. Un familiar puede agregarlos con el botón naranja de abajo."
            android:visibility="gone" />

        <!-- Fotos -->
        <LinearLayout
            android:id="@+id/panelFotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:background="@drawable/bg_tarjeta"
                android:contentDescription="Foto del recuerdo"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvTituloFoto"
                style="@style/AM.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvContador"
                style="@style/AM.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAnterior"
                    style="@style/AM.Boton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_gris"
                    android:minHeight="80dp"
                    android:text="◀ ANTERIOR"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnSiguiente"
                    style="@style/AM.Boton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_gris"
                    android:minHeight="80dp"
                    android:text="SIGUIENTE ▶"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Audios -->
        <LinearLayout
            android:id="@+id/panelAudios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llAudios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAgregarRecuerdos"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_naranja"
            android:text="➕  Agregar fotos o audios (solo familiar)" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_gris"
            android:text="VOLVER" />

    </LinearLayout>
</ScrollView>
