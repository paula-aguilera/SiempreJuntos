<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨  Más cosas para usted" />

        <TextView
            style="@style/AM.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Elija con calma. Aquí no hay apuro." />

        <Button
            android:id="@+id/btnMasBienestar"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_azul"
            android:text="🎵  Música y bienestar" />

        <Button
            android:id="@+id/btnMasAprender"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_verde"
            android:text="🎓  Aprender" />

        <Button
            android:id="@+id/btnMasFe"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:background="@drawable/bg_btn_verde"
            android:text="📖  Palabras de ánimo" />

        <Button
            android:id="@+id/btnMasEstoyBien"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_naranja"
            android:text="💬  Avisar cómo estoy" />

        <Button
            android:id="@+id/btnMasEmergencia"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_gris"
            android:text="📋  Números de emergencia" />

    </LinearLayout>
</ScrollView>
