<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Mi familia" />

        <TextView
            android:id="@+id/tvVacio"
            style="@style/AM.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Aún no hay contactos guardados. Un familiar puede agregarlos en Configuración."
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/AM.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Para hacer una videollamada: toque WHATSAPP y luego la cámara 🎥 que aparece arriba a la derecha."
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_gris"
            android:text="VOLVER" />

    </LinearLayout>
</ScrollView>
