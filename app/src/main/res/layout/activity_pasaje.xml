<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvReferencia"
                style="@style/AM.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvPensamiento"
                style="@style/AM.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="140dp"
                android:textSize="26sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEscucharPasaje"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_btn_verde"
            android:text="🔊  Escuchar" />

        <Button
            android:id="@+id/btnLeerPasaje"
            style="@style/AM.Boton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_btn_azul"
            android:text="📖  Leer este pasaje" />

        <Button
            android:id="@+id/btnOtroPasaje"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_btn_verde"
            android:text="Otro pasaje  ▶" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_gris"
            android:text="Volver" />
    </LinearLayout>
</ScrollView>
