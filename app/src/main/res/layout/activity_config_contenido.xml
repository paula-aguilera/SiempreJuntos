<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Saludo, música y videos" />

        <TextView
            style="@style/AM.TextoSuave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Para el familiar: aquí se personaliza lo que la persona ve cada día." />

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recordatorio importante de hoy"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tarjeta"
            android:hint="Ej: Hoy viene Pedro a las 4 de la tarde"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="64dp"
            android:padding="14dp"
            android:textColor="@color/am_texto"
            android:textColorHint="#9AA5B1"
            android:textSize="18sp" />

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Música que le gusta"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etMusica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tarjeta"
            android:hint="Ej: boleros, cueca, Los Ángeles Negros"
            android:inputType="textCapSentences"
            android:minHeight="64dp"
            android:padding="14dp"
            android:textColor="@color/am_texto"
            android:textColorHint="#9AA5B1"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbRemedios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minHeight="56dp"
            android:text="Preguntar por los remedios en el saludo (opcional)"
            android:textColor="@color/am_texto"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbFe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:minHeight="56dp"
            android:text="Mostrar &quot;Palabras de ánimo&quot; (pensamientos y lectura de la Biblia) en el inicio"
            android:textColor="@color/am_texto"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnGuardarContenido"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_btn_verde"
            android:text="Guardar" />

        <TextView
            style="@style/AM.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Videos de la familia"
            android:textSize="20sp" />

        <TextView
            style="@style/AM.TextoSuave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Pegue el enlace de un video (por ejemplo de YouTube) y póngale un nombre." />

        <EditText
            android:id="@+id/etVideoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_tarjeta"
            android:hint="Nombre del video"
            android:inputType="textCapSentences"
            android:minHeight="56dp"
            android:padding="12dp"
            android:textColor="@color/am_texto"
            android:textColorHint="#9AA5B1"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_tarjeta"
            android:hint="Enlace (https://...)"
            android:inputType="textUri"
            android:minHeight="56dp"
            android:padding="12dp"
            android:textColor="@color/am_texto"
            android:textColorHint="#9AA5B1"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnAgregarVideo"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_azul"
            android:text="Agregar video" />

        <LinearLayout
            android:id="@+id/llVideosCfg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnVolver"
            style="@style/AM.BotonChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_gris"
            android:text="Listo, volver" />
    </LinearLayout>
</ScrollView>
